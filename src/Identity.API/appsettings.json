{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "PasswordHasher": {
    // OWASP Password Storage Cheat Sheet figure for PBKDF2-HMAC-SHA512, which is the algorithm
    // ASP.NET Identity v3 hashing uses. The framework default is 100,000 and does not move when
    // the guidance does, so the number lives here: raising it is a settings change, not a release.
    "IterationCount": 220000
  },
  "Session": {
    "ExpireTimeSpan": "02:00:00",
    "SlidingExpiration": false
  },
  "Oidc": {
    "Scopes": [
      {
        "Scope": "profile",
        "ClaimTypes": [
          "last_name"
        ]
      },
      {
        "Scope": "address",
        "ClaimTypes": [
          "address_city",
          "address_country",
          "address_state",
          "address_street",
          "address_zip_code"
        ]
      },
      {
        "Scope": "orders"
      },
      {
        "Scope": "basket"
      },
      {
        "Scope": "webhooks"
      }
    ],
    "Clients": {
      "maui": {
        "BaseAddress": "maui://authcallback",
        "RedirectPaths": [
          ""
        ],
        "PostLogoutRedirectPaths": [
          ""
        ],
        "Client": {
          "ClientName": "eShop MAUI OpenId Client",
          "ClientSecrets": [
            {
              "Sha256HashHex": "2BB80D537B1DA3E38BD30361AA855686BDE0EACD7162FEF6A25FE97BF527A25B"
            }
          ],
          // IdentityModel's OidcClient, which the MAUI app uses, sends the secret in the request
          // body, and the method is matched exactly at the token endpoint.
          "TokenEndpointAuthMethod": "client_secret_post",
          // offline_access grants the refresh token; refresh_token grants the right to spend it.
          "AllowedGrantTypes": [
            "authorization_code",
            "refresh_token"
          ],
          "OfflineAccessAllowed": true,
          "AllowedScopes": [
            "openid",
            "profile",
            "offline_access",
            "orders",
            "basket",
            "webhooks"
          ],
          "ForceUserClaimsInIdentityToken": true,
          "AccessTokenExpiresIn": "02:00:00",
          "IdentityTokenExpiresIn": "02:00:00",
          // The app refreshes only minutes before its two-hour access token expires, so a refresh
          // token that lapses after an hour of disuse would already be dead by then. Its services
          // read the stored token without a lock, so one of them can present a token another has
          // just spent; a single-use token would then revoke the whole chain and sign the user out.
          "RefreshToken": {
            "AbsoluteExpiresIn": "30.00:00:00",
            "SlidingExpiresIn": null,
            "AllowReuse": true
          }
        }
      },
      "webapp": {
        "BaseAddress": "https://localhost:7298",
        "RedirectPaths": [
          "/signin-oidc"
        ],
        "PostLogoutRedirectPaths": [
          "/signout-callback-oidc"
        ],
        "Client": {
          "ClientName": "WebApp Client",
          "ClientSecrets": [
            {
              "Sha256HashHex": "2BB80D537B1DA3E38BD30361AA855686BDE0EACD7162FEF6A25FE97BF527A25B"
            }
          ],
          "TokenEndpointAuthMethod": "client_secret_post",
          "AllowedGrantTypes": [
            "authorization_code"
          ],
          "AllowedScopes": [
            "openid",
            "profile",
            "address",
            "orders",
            "basket"
          ],
          "ForceUserClaimsInIdentityToken": true,
          "AccessTokenExpiresIn": "02:00:00",
          "IdentityTokenExpiresIn": "02:00:00",
          "AuthorizationCodeExpiresIn": "00:05:00"
        }
      },
      "webhooksclient": {
        "BaseAddress": "https://localhost:7260",
        "RedirectPaths": [
          "/signin-oidc"
        ],
        "PostLogoutRedirectPaths": [
          "/signout-callback-oidc"
        ],
        "Client": {
          "ClientName": "Webhooks Client",
          "ClientSecrets": [
            {
              "Sha256HashHex": "2BB80D537B1DA3E38BD30361AA855686BDE0EACD7162FEF6A25FE97BF527A25B"
            }
          ],
          "TokenEndpointAuthMethod": "client_secret_post",
          "AllowedGrantTypes": [
            "authorization_code"
          ],
          "AllowedScopes": [
            "openid",
            "profile",
            "webhooks"
          ],
          "ForceUserClaimsInIdentityToken": true,
          "AccessTokenExpiresIn": "02:00:00",
          "IdentityTokenExpiresIn": "02:00:00",
          "AuthorizationCodeExpiresIn": "00:05:00"
        }
      }
    }
  }
}
