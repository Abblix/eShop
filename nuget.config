<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- Pre-release builds of the Abblix packages. GitHub Packages always requires
         authentication: restore reads it from the NuGetPackageSourceCredentials_abblix
         environment variable, set to Username=<GitHub user>;Password=<token with read:packages>. -->
    <add key="abblix" value="https://nuget.pkg.github.com/Abblix/index.json" />
  </packageSources>
  <packageSourceMapping>
    <!-- key value for <packageSource> should match key values from <packageSources> element -->
    <clear />
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="abblix">
      <package pattern="Abblix.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>