<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
    <!--To inherit the global NuGet package sources remove the <clear/> line below -->
    <clear />
    <add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!-- Pre-release builds of the Abblix packages. GitHub Packages always requires
         authentication, so a restore needs a personal access token with read:packages
         supplied through user-level credentials or the NUGET_AUTH_TOKEN environment. -->
    <add key="abblix-github" value="https://nuget.pkg.github.com/Abblix/index.json" />
  </packageSources>

  <packageSourceMapping>
    <!-- key value for <packageSource> should match key values from <packageSources> element -->
    <clear />
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="abblix-github">
      <package pattern="Abblix.*" />
    </packageSource>
  </packageSourceMapping>
</configuration>
